# Application
PROJECT_NAME="AI Career Copilot"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Security (Required: generate a strong cryptographically secure secret, e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars

# PostgreSQL Database Configuration
# NOTE: For local Windows development (e.g. running uvicorn directly on the host), use host 'localhost'.
# For Docker Compose (running within the container network), use host 'postgres'.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=copilot_dev_user
POSTGRES_PASSWORD=copilot_dev_secure_password
POSTGRES_DB=ai_career_copilot
# Async database URL format:
# Local dev:      postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Docker Compose: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://copilot_dev_user:copilot_dev_secure_password@localhost:5432/ai_career_copilot

# Neo4j Graph Database Configuration
# Local dev:      bolt://localhost:7687
# Docker Compose: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=copilot_neo4j_secure_password

# CORS
# Comma-separated list of origins or JSON array for development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# AI Providers & Models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
