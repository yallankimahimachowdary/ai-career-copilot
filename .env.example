# Application
PROJECT_NAME="AI Career Copilot"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="temporary-dev-secret-key-change-in-production"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_career_copilot
# Async database URL format
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_career_copilot

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# CORS
# Comma-separated list of origins or "*" for development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# AI Providers & Models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
