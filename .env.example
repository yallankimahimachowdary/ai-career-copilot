# Application
PROJECT_NAME="AI Career Copilot"
ENVIRONMENT=development
DEBUG=False
API_V1_STR="/api/v1"

# Security (Required: generate a strong cryptographically secure secret, e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars

# PostgreSQL Database Configuration
# NOTE: For local Windows development (e.g. running uvicorn directly on the host), use host 'localhost'.
# For Docker Compose (running within the container network), use host 'postgres'.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=copilot_dev_user
POSTGRES_PASSWORD=copilot_dev_secure_password
POSTGRES_DB=ai_career_copilot
# Async database URL format:
# Local dev:      postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Docker Compose: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://copilot_dev_user:copilot_dev_secure_password@localhost:5432/ai_career_copilot

# Neo4j Graph Database Configuration
# Local dev:      bolt://localhost:7687
# Docker Compose: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=copilot_neo4j_secure_password

# CORS
# Comma-separated list of origins or JSON array for development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]

# LLM Provider Configuration
# "ollama" for local privacy-preserving execution, or "gemini" / "openai" for cloud API
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# AI Cloud Providers & Models (Optional when using Ollama or rule-based fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# Job Freshness & Market Ingestion Settings (Phase 6)
JOB_STALE_DAYS_THRESHOLD=14
JOB_EXPIRED_DAYS_THRESHOLD=30
JOB_REFRESH_INTERVAL_HOURS=24
JOB_INGESTION_MAX_RETRIES=3
JOB_INGESTION_TIMEOUT_SECONDS=30.0

# Optional Adzuna API for live market refresh & Quota Guard (R8)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_CALL_BUDGET=20

# Scraper Gating (R8)
SCRAPER_ENABLED=false

# Multi-Agent Orchestrator Configuration (Phase R4)
# Options: "langgraph" (default state graph) or "sequential" (legacy linear pipeline)
ORCHESTRATOR_BACKEND=langgraph

# Seniority Gate Configuration (Phase R9)
# When enabled (default True), junior candidates are excluded from senior/lead roles and vice-versa
SENIORITY_GATE=true
PARSER_MODE=hybrid
